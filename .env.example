# Copy to .env (git-ignored) for docker compose. Never commit real values.
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=

# S27: hours an unfinished resumable upload is kept (default 24)
# UPLOAD_INCOMPLETE_RETENTION_HOURS=24

# S23: semantic search. Qdrant starts with docker compose; the embedding model is local (Ollama) by default.
# EMBEDDING_OLLAMA_ENDPOINT=http://host.docker.internal:11434
# EMBEDDING_MODEL=bge-m3
# Opt-in to OpenAI (transcript text then leaves this machine): EMBEDDING_PROVIDER=OpenAI, EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=OpenAI
# EMBEDDING_OPENAI_API_KEY=
# S28: allow webhook targets in private networks (e.g. an n8n container); default false = public https only
# WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# S28: e-mail address of the user who owns jobs created from the watched folder (see docker-compose.yml)
# WATCH_USER_EMAIL=
