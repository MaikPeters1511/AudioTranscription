# Copy to .env (git-ignored) for docker compose. Never commit real values.
INITIAL_USER_EMAIL=admin@example.com
# At least 12 characters
INITIAL_USER_PASSWORD=

# S27: hours an unfinished resumable upload is kept (default 24)
# UPLOAD_INCOMPLETE_RETENTION_HOURS=24

# Local language models via LM Studio (OpenAI-compatible server on the host, default port 1234). Start the local server
# in LM Studio and load a chat model and an embedding model. Empty = no local language model.
# LMSTUDIO_ENDPOINT=http://host.docker.internal:1234/v1

# S23: semantic search. Qdrant starts with docker compose; the embedding model is local (LM Studio) by default.
# EMBEDDING_MODEL=text-embedding-bge-m3
# Opt-in to OpenAI (transcript text then leaves this machine): EMBEDDING_PROVIDER=OpenAI, EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_PROVIDER=OpenAI
# EMBEDDING_OPENAI_API_KEY=

# S24: chat with the transcripts. Local by default (LMSTUDIO_ENDPOINT).
# CHAT_MODEL=llama-3.2-3b-instruct
# External provider (questions and transcript passages then leave this machine): CHAT_PROVIDER=OpenAI, CHAT_MODEL=gpt-4o-mini
# CHAT_PROVIDER=OpenAI
# CHAT_OPENAI_API_KEY=
# CHAT_REQUESTS_PER_MINUTE=20
# S28: allow webhook targets in private networks (e.g. an n8n container); default false = public https only
# WEBHOOKS_ALLOW_PRIVATE_TARGETS=false

# S28: e-mail address of the user who owns jobs created from the watched folder (see docker-compose.yml)
# WATCH_USER_EMAIL=
