{
  "resources": {
    "sql": {
      "type": "container.v0",
      "connectionString": "Server={sql.bindings.tcp.host},{sql.bindings.tcp.port};User ID=sa;Password={sql-password.value};TrustServerCertificate=true",
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "volumes": [
        {
          "name": "audio-transcription-sqldata",
          "target": "/var/opt/mssql",
          "readOnly": false
        }
      ],
      "env": {
        "ACCEPT_EULA": "Y",
        "MSSQL_SA_PASSWORD": "{sql-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 1433
        }
      }
    },
    "transcriptiondb": {
      "type": "value.v0",
      "connectionString": "{sql.connectionString};Initial Catalog=transcriptiondb"
    },
    "api": {
      "type": "project.v0",
      "path": "../AudioTranscription.Api/AudioTranscription.Api.csproj",
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{api.bindings.http.targetPort}",
        "ConnectionStrings__transcriptiondb": "{transcriptiondb.connectionString}",
        "TRANSCRIPTIONDB_HOST": "{sql.bindings.tcp.host}",
        "TRANSCRIPTIONDB_PORT": "{sql.bindings.tcp.port}",
        "TRANSCRIPTIONDB_USERNAME": "sa",
        "TRANSCRIPTIONDB_PASSWORD": "{sql-password.value}",
        "TRANSCRIPTIONDB_URI": "mssql://sa:{sql-password.value}@{sql.bindings.tcp.host}:{sql.bindings.tcp.port}/transcriptiondb",
        "TRANSCRIPTIONDB_JDBCCONNECTIONSTRING": "jdbc:sqlserver://{sql.bindings.tcp.host}:{sql.bindings.tcp.port};databaseName=transcriptiondb;trustServerCertificate=true",
        "TRANSCRIPTIONDB_DATABASENAME": "transcriptiondb"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http"
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http"
        }
      }
    },
    "web": {
      "type": "container.v1",
      "build": {
        "context": "../AudioTranscription.Web",
        "dockerfile": "../AudioTranscription.Web/Dockerfile"
      },
      "env": {
        "NODE_ENV": "development",
        "API_HTTP": "{api.bindings.http.url}",
        "services__api__http__0": "{api.bindings.http.url}",
        "API_HTTPS": "{api.bindings.https.url}",
        "services__api__https__0": "{api.bindings.https.url}",
        "PORT": "{web.bindings.http.targetPort}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "targetPort": 8000,
          "external": true
        }
      }
    },
    "sql-password": {
      "type": "parameter.v0",
      "value": "{sql-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "minLower": 1,
              "minUpper": 1,
              "minNumeric": 1
            }
          }
        }
      }
    },
    "sql-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{sql-password.value}",
      "filter": "uri"
    }
  }
}