temp-uploads/
**/temp-uploads/
*.mp3
*.ogg
*.wav
*.m4a
*.flac
*.webm
*.opus

# Whisper GGML models (downloaded at runtime, several hundred MB)
whisper-models/
**/whisper-models/
ggml-*.bin

