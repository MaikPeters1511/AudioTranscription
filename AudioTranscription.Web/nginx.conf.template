server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # S14: matches the .NET API's Upload:MaxFileSizeBytes, both derived from
    # the docker-compose UPLOAD_MAX_FILE_SIZE_MB value - otherwise nginx's own
    # default (1 MB) would reject large uploads before they reach the API.
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location / {
        try_files $uri $uri/ /index.html;
    }

    # S33 / ADR 0012: the service worker, its file list and the manifest must always be revalidated, otherwise a
    # new app version is not noticed. (Hashed bundles stay cacheable.) The service worker only works over HTTPS
    # (or on localhost), see the README.
    location = /ngsw-worker.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /ngsw.json {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /safety-worker.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
        try_files $uri =404;
    }

    # S27 / ADR 0006: resumable uploads (tus). Chunks are 5 MiB, so a small limit is enough here; the request is
    # streamed to the API instead of being buffered, and PATCH/HEAD/DELETE plus the Upload-* headers pass through.
    location /api/uploads {
        client_max_body_size 16M;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 300s;
        proxy_pass http://api:8080/api/uploads;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy API requests to backend
    location /api/ {
        proxy_pass http://api:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy SignalR WebSockets
    location /hubs/ {
        proxy_pass http://api:8080/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
